# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — real keys NEVER get committed.

# Google Gemini API key (FREE — no credit card needed).
# Get one at https://aistudio.google.com → "Get API key".
# Powers article ranking, card cutting, the Coach, and the Theme agent
# (generate a UI theme from a vibe). No separate key needed for themes.
GEMINI_API_KEY=

# Optional: override the Gemini model (default set in lib/gemini.ts)
# GEMINI_MODEL=gemini-2.5-flash

# Tavily web search (FREE — 1,000 searches/month, NO credit card).
# Lets the Article Finder search the OPEN WEB (reputable news, think tanks,
# .gov/.org reports) alongside the scholarly databases. Without it, search
# still works but is academic-only.
# Get one at https://app.tavily.com → sign in with Google/email → copy your
# API key (starts with "tvly-").
TAVILY_API_KEY=

# Optional web-search budget guards (protect the free Tavily credits). Defaults:
# 5 web searches per person per day, 900 per month app-wide. Over a cap, search
# falls back to academic-only. Raise/lower without touching code.
# WEB_SEARCH_DAILY_LIMIT=5
# WEB_SEARCH_MONTHLY_LIMIT=900

# Upstash Redis (FREE tier, NO credit card) — the scaling layer: a shared cache
# across all users (repeat searches/cuts become free for everyone), a global
# Gemini rate throttle, and a durable web-search limiter. WITHOUT it the app
# still works (in-memory, single-instance). Easiest: Vercel dashboard → Storage
# → Create Database → Upstash (Redis) → connect; it sets these for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Gemini throughput tuning (protect the shared free key under load):
# GEMINI_MAX_CONCURRENCY — simultaneous Gemini calls per instance (default 4)
# GEMINI_RPM_LIMIT — global calls/minute before smoothing kicks in (default 55)
# GEMINI_MAX_CONCURRENCY=4
# GEMINI_RPM_LIMIT=55

# Supabase (deferred — cached article metadata if/when added)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
