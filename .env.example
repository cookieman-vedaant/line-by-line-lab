# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — real keys NEVER get committed.

# Google Gemini API key (FREE — no credit card needed).
# Get one at https://aistudio.google.com → "Get API key".
# Powers article ranking, card cutting, the Coach, and the Theme agent
# (generate a UI theme from a vibe). No separate key needed for themes.
GEMINI_API_KEY=

# Optional: override the Gemini model (default set in lib/gemini.ts)
# GEMINI_MODEL=gemini-2.5-flash

# Tavily web search (FREE — 1,000 searches/month, NO credit card).
# Lets the Article Finder search the OPEN WEB (reputable news, think tanks,
# .gov/.org reports) alongside the scholarly databases. Without it, search
# still works but is academic-only.
# Get one at https://app.tavily.com → sign in with Google/email → copy your
# API key (starts with "tvly-").
TAVILY_API_KEY=

# Optional web-search budget guards (protect the free Tavily credits). Defaults:
# 5 web searches per person per day, 900 per month app-wide. Over a cap, search
# falls back to academic-only. Raise/lower without touching code.
# WEB_SEARCH_DAILY_LIMIT=5
# WEB_SEARCH_MONTHLY_LIMIT=900

# Upstash Redis (FREE tier, NO credit card) — the scaling layer: a shared cache
# across all users (repeat searches/cuts become free for everyone), a global
# Gemini rate throttle, and a durable web-search limiter. WITHOUT it the app
# still works (in-memory, single-instance). Easiest: Vercel dashboard → Storage
# → Create Database → Upstash (Redis) → connect; it sets these for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Gemini throughput tuning (protect the shared free key under load):
# GEMINI_MAX_CONCURRENCY — simultaneous Gemini calls per instance (default 4)
# GEMINI_RPM_LIMIT — global calls/minute before smoothing kicks in (default 55)
# GEMINI_MAX_CONCURRENCY=4
# GEMINI_RPM_LIMIT=55

# Cloudflare Turnstile (FREE CAPTCHA — no credit card). Adds a visible "verify
# you're human" gate on the Lab: a bot can't solve it, so it never gets the
# session cookie the AI endpoints require. WITHOUT both keys the gate stays OFF
# (the app works exactly as before) — add them to switch it on.
# Create a widget at https://dash.cloudflare.com → Turnstile → copy the two keys.
# The SITE key is public (safe in the browser); the SECRET key is server-only and
# also signs the session cookie. Both must be set in Vercel env for production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase — accounts + database (login system). From Supabase → Settings → API.
# URL + anon key are public (browser); service_role is a MASTER key (server-only,
# never commit). Set all three in Vercel env for production too.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AI MODEL ROUTING (optional — sensible defaults ship in lib/models.ts)
# ─────────────────────────────────────────────────────────────────────────────
# Model choice is per-TASK and per-TIER, because a bigger model helps some tasks
# a lot and others not at all. Tasks: EXPAND, RANK, SELECT, MARK, COACH, THEME,
# PROFILE. Override the most specific first:
#   GEMINI_MODEL_<TASK>_<TIER>   e.g. GEMINI_MODEL_COACH_PRO
#   GEMINI_MODEL_<TASK>          e.g. GEMINI_MODEL_MARK       (both tiers)
#
# ALWAYS verify a model works on YOUR key before promoting it — availability is
# per-key and per-config, and a bad ID takes the feature down for everyone:
#   node --env-file=.env.local scripts/check-models.mjs
#
# Prices per 1M tokens (Google paid tier, Aug 2026) — output dominates our bill:
#   gemini-3.1-flash-lite  $0.25 in / $1.50 out   (default for mechanical tasks)
#   gemini-3.5-flash-lite  $0.30 in / $2.50 out
#   gemini-3.6-flash       $1.50 in / $7.50 out   (strictly better value than 3.5)
#   gemini-3.5-flash       $1.50 in / $9.00 out   (current default for MARK)
# GEMINI_MODEL_MARK=gemini-3.6-flash
# GEMINI_MODEL_COACH_PRO=gemini-3.6-flash

# Thinking budget in tokens. Keep 0 for anything returning JSON (a thinking
# model with a small output cap truncates the JSON). Only COACH benefits.
# GEMINI_THINKING_COACH_PRO=2048

# Salt for hashing emails before they become rate-limit keys, so raw addresses
# never reach Upstash. Set any long random string in production.
AUTH_HASH_SALT=

# Set to 1 to ENFORCE the Content-Security-Policy instead of only reporting it.
# Load every page with the console open and confirm zero CSP violations first —
# an enforced policy with a missing allowance breaks the app for everyone.
# CSP_ENFORCE=1

# Resend — transactional email (FREE: 3,000/month, no credit card).
# WITHOUT this, in-app feedback is still SAVED to the `feedback` table but nobody
# is notified — which is how bug reports silently piled up unread. Set it to get
# an email per report. Sign up at https://resend.com with the address below.
# Until you verify a domain, Resend only delivers to your own account address,
# which is exactly the operator-notification case.
RESEND_API_KEY=
# Optional: override the sender once you've verified a domain in Resend.
# EMAIL_FROM="Line by Line Lab <hello@yourdomain.com>"

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/purge (the GDPR retention job). REQUIRED in production — without it
# the route refuses to run, since it deletes data.
CRON_SECRET=

# Max serialized bytes a cached value may be before it's kept in local memory
# only instead of being written to Redis. Guards the Upstash free tier against
# large payloads (full article text was blowing through the request/bandwidth
# limits). Default 65536.
# CACHE_MAX_REDIS_BYTES=65536
