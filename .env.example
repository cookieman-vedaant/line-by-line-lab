# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — real keys NEVER get committed.

# Claude API (server-side only — never exposed to the browser)
# Needed starting Phase 2 (Article Finder). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase (deferred to Phase 2 — used for cached article metadata)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
