# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — real keys NEVER get committed.

# Google Gemini API key (FREE — no credit card needed).
# Get one at https://aistudio.google.com → "Get API key".
# Powers query expansion, article ranking, and card cutting.
GEMINI_API_KEY=

# Optional: override the Gemini model (default set in lib/gemini.ts)
# GEMINI_MODEL=gemini-2.5-flash

# Supabase (deferred — cached article metadata if/when added)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
